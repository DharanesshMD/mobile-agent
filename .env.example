# Copy to .env and fill in. .env is gitignored: never commit it.

# Required: your Meta Model API key (https://dev.meta.ai)
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# Optional ---------------------------------------------------------------
# Listen address and port. The default is 127.0.0.1:8000. Any other HOST needs APP_TOKEN.
# HOST=127.0.0.1
# PORT=8000
# Bearer token required for every API call (mandatory if HOST is not loopback). Use a long random value.
# APP_TOKEN=

# Phones
# ANDROID_SERIAL=emulator-5554        # the shared emulator (default)
# PHONE_PROFILE=light                 # light = 720x1600, animations off (set to off to disable)
# PHONE_SLEEP=on                      # on = the emulator sleeps when idle (off = always on)
# GAMES_PHONE=on                      # off disables the Redroid "Games phone" bot
# ADB_PHONES=name=serial,name2=serial2  # extra adb phones (a USB phone, BlueStacks with adb enabled, ...)

# Web research for the "other ways" card uses the Meta API's web search by default.
# A Brave Search key switches to Brave instead.
# SEARCH_API_KEY=

# Open-weight orchestrator (optional, the "Best Build on Meta Open Weight Models" path): Muse Spark Open served by Baseten.
# ORCHESTRATOR_BACKEND=meta is the default (Muse Spark 1.3 on Meta's API). Set baseten to run the orchestrator on open weights; the phone worker stays Muse Wonder.
ORCHESTRATOR_BACKEND=meta
BASETEN_API_KEY=
OPEN_WEIGHT_MODEL=meta-models/muse-spark-open-1026
OPEN_WEIGHT_BASE_URL=https://inference.baseten.co/v1
# on (default, Baseten's changelog says the model accepts images) or off: with off, pictures are described as unsupported unless the fallback below is set
OPEN_WEIGHT_VISION=on
# meta: send a message that carries a picture to Muse Spark 1.3 instead (only when the open model cannot read it). Empty: never.
OPEN_WEIGHT_VISION_FALLBACK=
# on: ask for JSON mode (response_format json_object); off by default until it is verified for this model
OPEN_WEIGHT_JSON_MODE=off

